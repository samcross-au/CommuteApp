{
  "version": 2,
  "git": {
    "deploymentEnabled": false
  },
  "functions": {
    "api/index.js": {
      "includeFiles": "handlers/**,public/**,src/**,data/**,config/**,fonts/**",
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/setup-wizard.html",
      "permanent": false
    },
    {
      "source": "/admin",
      "destination": "/admin.html",
      "permanent": false
    },
    {
      "source": "/setup",
      "destination": "/setup-wizard.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api?__ccroute=health"
    },
    {
      "source": "/ipad",
      "destination": "/ipad.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api?__ccroute=$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; connect-src 'self' https://api.opendata.transport.vic.gov.au https://maps.googleapis.com https://places.googleapis.com https://*.vercel.app; font-src 'self' data: https://fonts.googleapis.com https://fonts.gstatic.com; frame-ancestors 'none'"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
